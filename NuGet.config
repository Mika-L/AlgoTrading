<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- <clear/> neutralise le feed d'entreprise hérité du NuGet.config global,
       qui masque nuget.org pour certains paquets. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
