<Project Sdk="Microsoft.NET.Sdk">

  <!-- Aucune ProjectReference, aucun paquet d'infrastructure : la frontière est tenue
       par le compilateur. `using Microsoft.EntityFrameworkCore;` ne compilera pas ici. -->
  <PropertyGroup>
    <RootNamespace>AlgoTrading.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AlgoTrading.Domain.Tests" />
    <InternalsVisibleTo Include="AlgoTrading.Application" />
  </ItemGroup>

  <ItemGroup>
    <!-- Avec TreatWarningsAsErrors, une entrée de ce fichier devient une erreur de
         compilation : c'est ce qui empêche durablement le retour des 45 Console.*
         et du File.WriteAllLines au cœur de la boucle de backtest. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

</Project>
